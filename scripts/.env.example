# Copier ce fichier vers .env et remplir les valeurs (ne jamais committer .env)

# --- Texte de l’article (IA) : au moins UNE des clés ci-dessous ---
# Priorité automatique : Gemini → Groq → OpenAI

# 1) Google Gemini — GRATUIT (quota) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2) Groq — GRATUIT (limites de débit) : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenAI — PAYANT (optionnel, utilisé seulement si pas de clé Gemini/Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Image de couverture ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- E-mail (optionnel) ---
# Gmail : mot de passe d’application — https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=imdadadenon@gmail.com
# SKIP_EMAIL=1
